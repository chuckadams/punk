/* Number of bytes for the logarithmic ZEND_MM alignment. */
#mesondefine ZEND_MM_ALIGNMENT_LOG2

/* Define to 1 if ZEND_MM needs 8-byte realignment, and to 0 if not. */
#mesondefine ZEND_MM_NEED_EIGHT_BYTE_REALIGNMENT

/* Define to 1 if Zend signal handling is supported and enabled. */
#mesondefine ZEND_SIGNALS

/* Whether to track arena allocations individually for AddressSanitizer. */
#mesondefine ZEND_TRACK_ARENA_ALLOC

/* Define to 1 if thread safety (ZTS) is enabled. */
#mesondefine ZTS

/* */
#mesondefine _XOPEN_SOURCE

/* Define to 1 when using musl libc. */
#mesondefine __MUSL__

/* Define as 'int' if <sys/types.h> doesn't define. */
#mesondefine gid_t

/* Define as 'unsigned int' if <stddef.h> doesn't define. */
#mesondefine size_t

/* Define as 'int' if <sys/types.h> doesn't define. */
#mesondefine uid_t


#include <stdlib.h>

#ifdef HAVE_SYS_TYPES_H
# include <sys/types.h>
#endif

#ifdef HAVE_SYS_SELECT_H
#include <sys/select.h>
#endif

#include <string.h>

#endif /* PHP_CONFIG_H */

