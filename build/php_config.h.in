/*
   punk config header template.

   Replaces the autoheader output that autoconf generated from configure.ac.
   configure_file() rewrites "#mesondefine NAME" into "#define NAME value" when
   NAME is set and into a commented-out undef when it is not -- meson does not
   understand autoconf's bare "#undef NAME" form, which is the only difference
   from the old template.  Tracked, unlike the generated main/php_config.h.in.
*/


#ifndef PHP_CONFIG_H
#define PHP_CONFIG_H

/* The equivalent of autoconf's AC_USE_SYSTEM_EXTENSIONS, which is what makes
   the GNU/POSIX extensions visible to both the checks below and the build
   itself.  Guarded so a platform or the command line can override it; other
   POSIX systems also want __EXTENSIONS__ (Solaris) or _ALL_SOURCE (AIX). */
#ifndef _GNU_SOURCE
# define _GNU_SOURCE 1
#endif

/* macOS extensions: pthread_main_np, and ucontext behind _XOPEN_SOURCE. */
#ifdef __APPLE__
# ifndef _DARWIN_C_SOURCE
#  define _DARWIN_C_SOURCE 1
# endif
#endif

#if defined(__GNUC__) && __GNUC__ >= 4
# define ZEND_API __attribute__ ((visibility("default")))
# define ZEND_DLEXPORT __attribute__ ((visibility("default")))
#else
# define ZEND_API
# define ZEND_DLEXPORT
#endif

#define ZEND_DLIMPORT


