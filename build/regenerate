#!/usr/bin/env bash
# shellcheck disable=SC2046
# shellcheck disable=SC2086

cd $(dirname $0)/..

set -euo pipefail
set -x

re2c --no-generation-date -W -g --case-inverted -cbdFt Zend/zend_language_scanner_defs.h -oZend/zend_language_scanner.c Zend/zend_language_scanner.l
re2c --no-generation-date -W -g --case-inverted -cbdFt Zend/zend_ini_scanner_defs.h -oZend/zend_ini_scanner.c Zend/zend_ini_scanner.l

bison -Wall -v -d Zend/zend_language_parser.y -o Zend/zend_language_parser.c
perl -pi -e 's/^int zendparse/ZEND_API int zendparse/g' Zend/zend_language_parser.[ch]

bison -Wall -v -d Zend/zend_ini_parser.y -o Zend/zend_ini_parser.c

re2c --no-generation-date -W -g -t ext/json/php_json_scanner_defs.h -bci -o ext/json/json_scanner.c ext/json/json_scanner.re
bison -Wall --defines -l ext/json/json_parser.y -o ext/json/json_parser.tab.c

re2c --no-generation-date -W -g -b -o ext/standard/url_scanner_ex.c	ext/standard/url_scanner_ex.re
re2c --no-generation-date -W -g -b -o ext/standard/var_unserializer.c ext/standard/var_unserializer.re

re2c --no-generation-date -W -g -o ext/pdo/pdo_sql_parser.c ext/pdo/pdo_sql_parser.re
re2c --no-generation-date -W -g -o ext/pdo_mysql/mysql_sql_parser.c ext/pdo_mysql/mysql_sql_parser.re
re2c --no-generation-date -W -g -o ext/pdo_pgsql/pgsql_sql_parser.c ext/pdo_pgsql/pgsql_sql_parser.re
re2c --no-generation-date -W -g -o ext/pdo_sqlite/sqlite_sql_parser.c ext/pdo_sqlite/sqlite_sql_parser.re
re2c --no-generation-date -W -g -b -o ext/phar/phar_path_check.c ext/phar/phar_path_check.re

php Zend/zend_vm_gen.php
