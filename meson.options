# Options land here as the autoconf port progresses: --with/--enable become
# feature options here, and meson setup -D<name>=... / meson configure -D<name>=...
# replace the old configure flags.  For now only the migration switch below
# exists, and it will go away with the last generated header.

# Build variants.  The defaults reproduce the configuration punk has always been
# built with (matching platform/_common/configure-cli); the autoconf spellings
# were --enable-debug --enable-zts --enable-sigchild --disable-fiber-asm.
option('zts', type : 'boolean', value : true, description : 'Build thread-safe (ZTS)')
option('zend-debug', type : 'boolean', value : true, description : 'Build with ZEND_DEBUG')
option('sigchild', type : 'boolean', value : true, description : 'Enable the sigchild handling')
option('fiber-asm', type : 'boolean', value : false, description : 'Use assembly fibers instead of ucontext')
