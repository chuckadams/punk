ext_gd_sources = files(
    'gd.c',
    'libgd/gd_avif.c',
    'libgd/gd_bmp.c',
    'libgd/gd_color_match.c',
    'libgd/gd_crop.c',
    'libgd/gd_filter.c',
    'libgd/gd_gd.c',
    'libgd/gd_gd2.c',
    'libgd/gd_gif_in.c',
    'libgd/gd_gif_out.c',
    'libgd/gd_interpolation.c',
    'libgd/gd_io_dp.c',
    'libgd/gd_io_file.c',
    'libgd/gd_io_ss.c',
    'libgd/gd_io.c',
    'libgd/gd_jpeg.c',
    'libgd/gd_matrix.c',
    'libgd/gd_metadata.c',
    'libgd/gd_png.c',
    'libgd/gd_rotate.c',
    'libgd/gd_security.c',
    'libgd/gd_ss.c',
    'libgd/gd_tga.c',
    'libgd/gd_topal.c',
    'libgd/gd_transform.c',
    'libgd/gd_wbmp.c',
    'libgd/gd_webp.c',
    'libgd/gd_xbm.c',
    'libgd/gd.c',
    'libgd/gdcache.c',
    'libgd/gdfontg.c',
    'libgd/gdfontl.c',
    'libgd/gdfontmb.c',
    'libgd/gdfonts.c',
    'libgd/gdfontt.c',
    'libgd/gdft.c',
    'libgd/gdhelpers.c',
    'libgd/gdkanji.c',
    'libgd/gdtables.c',
    'libgd/gdxpm.c',
    'libgd/wbmp.c',
    # The list above was copied from an older libgd and had drifted from
    # config.m4; everything below is built by the autotools build too. The
    # HAVE_LIBHEIF/LIBJXL/LIBTIFF/LIBUHDR sources compile to stubs while those
    # libraries are absent from the platform image.
    'libgd/gd_qoi.c',
    'libgd/gd_jxl.c',
    'libgd/gd_color_map.c',
    'libgd/gd_heif.c',
    'libgd/gd_uhdr.c',
    'libgd/gd_nnquant.c',
    'libgd/gd_color.c',
    'libgd/gd_tiff.c',
    'libgd/gd_readimage.c',
    'libgd/gd_filename.c',
    'libgd/ftraster/gd_ft_math.c',
    'libgd/ftraster/gd_ft_raster.c',
    'libgd/ftraster/gd_ft_stroker.c',
    'libgd/gd_array.c',
    'libgd/gd_span_rle.c',
    'libgd/gd_surface.c',
    'libgd/gd_version.c',
    'libgd/gd_compositor.c',
    'libgd/gd_gradient.c',
    'libgd/gd_path.c',
    'libgd/gd_path_arc.c',
    'libgd/gd_path_dash.c',
    'libgd/gd_path_matrix.c',
    'libgd/gd_path_stroke.c',
    'libgd/gd_draw.c',
    'libgd/gd_draw_blend.c',
    'libgd/gd_perceptual_diff.c',
)

shared_module(
    'gd',
    [ext_gd_sources],
    name_prefix : '',
    c_args : [],
    include_directories : [includes, 'libgd', 'libgd/ftraster'],
    dependencies : [
        dependency('freetype2'),
        dependency('libavif'),
        dependency('libjpeg'),
        dependency('libpng'),
        dependency('libwebp'),
        dependency('libwebpdemux'),
        dependency('libwebpmux'),
        dependency('xpm'),
    ],
    install : true,
)

install_headers(
    'php_gd.h',
    subdir : 'php/ext/gd',
)

# autoconf installs the whole ext/gd/libgd directory, because the bundled
# libgd's headers are part of the ext/gd API.  meson has no glob, so the list
# stays explicit and has to be kept in step with the directory.
install_headers(
    'libgd/bmp.h',
    'libgd/entities.h',
    'libgd/gd.h',
    'libgd/gd_array.h',
    'libgd/gd_color.h',
    'libgd/gd_color_map.h',
    'libgd/gd_compositor.h',
    'libgd/gd_draw_blend.h',
    'libgd/gd_errors.h',
    'libgd/gd_fixed.h',
    'libgd/gd_gradient.h',
    'libgd/gd_intern.h',
    'libgd/gd_io.h',
    'libgd/gd_nnquant.h',
    'libgd/gd_path.h',
    'libgd/gd_path_arc.h',
    'libgd/gd_path_dash.h',
    'libgd/gd_path_matrix.h',
    'libgd/gd_path_outline.h',
    'libgd/gd_qoi.h',
    'libgd/gd_span_rle.h',
    'libgd/gd_surface.h',
    'libgd/gd_tga.h',
    'libgd/gd_vector2d.h',
    'libgd/gd_vector2d_private.h',
    'libgd/gdcache.h',
    'libgd/gdfontg.h',
    'libgd/gdfontl.h',
    'libgd/gdfontmb.h',
    'libgd/gdfonts.h',
    'libgd/gdfontt.h',
    'libgd/gdfx.h',
    'libgd/gdhelpers.h',
    'libgd/jisx0208.h',
    'libgd/wbmp.h',
    subdir : 'php/ext/gd/libgd',
)
