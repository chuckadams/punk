#!/usr/bin/env bash
# Load every shared module produced by a meson build and report the ones that do
# not come up.
#
# Modules are loaded together, alphabetically, which happens to put providers
# such as pdo.so and dom.so ahead of their consumers. A module is considered
# broken unless the extension it contains is actually registered afterwards, so
# this catches all three ways a module can be wrong: a missing library
# ("undefined symbol"), a missing source file, and a module built without
# COMPILE_DL_<name> (which has no entry point and PHP rejects as an "invalid
# library" -- a warning that is easy to miss and, on stdout, breaks the test
# suite).
#
# usage: check-modules <meson build dir>

set -euo pipefail

build_dir=${1:?usage: check-modules <meson build dir>}
binary=$build_dir/sapi/cli/punk

if [ ! -x "$binary" ]; then
    echo "no punk binary at $binary -- run 'just all' or 'just compile' first" >&2
    exit 1
fi

modules=()
args=()
# Modules are always named .so (shared_module uses name_suffix: 'so'), but the
# eager-binding switch differs: DYLD_BIND_AT_LAUNCH on macOS, LD_BIND_NOW on ELF.
if [ "$(uname -s)" = "Darwin" ]; then
    bind_env=(env DYLD_BIND_AT_LAUNCH=1)
else
    bind_env=(env LD_BIND_NOW=1)
fi
# LC_ALL=C forces byte-wise ordering so 'pdo' sorts before 'pdo_mysql' etc.;
# a locale-aware sort (the macOS default) compares '/' and '_' by collation and
# would load the pdo drivers before the pdo extension they depend on.
for mod in $(find "$build_dir/ext" -name '*.so' | LC_ALL=C sort); do
    modules+=("$(basename "$mod" .so)")
    args+=(-d "extension=$mod")
done

if [ ${#modules[@]} -eq 0 ]; then
    echo "no shared modules found under $build_dir/ext" >&2
    exit 1
fi

# Eager binding forces every symbol to resolve at dlopen time. Without it, a
# missing library is only noticed when the module first calls into it, so a
# module could pass this check and still blow up later.
out=$("${bind_env[@]}" "$binary" -n "${args[@]}" \
    -r 'echo implode("\n", get_loaded_extensions());' 2>&1 || true)

loaded=$(printf '%s\n' "$out" | tr '[:upper:]' '[:lower:]' | sed 's/^zend //')
warnings=$(printf '%s\n' "$out" | grep -i "PHP Startup\|symbol lookup error" || true)

failed=()
for name in "${modules[@]}"; do
    grep -qx "$name" <<<"$loaded" || failed+=("$name")
done

if [ ${#failed[@]} -eq 0 ]; then
    echo "all ${#modules[@]} modules loaded"
    exit 0
fi

for name in "${failed[@]}"; do
    why=$(printf '%s\n' "$warnings" | grep "/$name\.so" | head -1 |
        grep -o "undefined symbol: [A-Za-z0-9_]*\|Invalid library" || true)
    printf 'FAIL %-16s %s\n' "$name" "${why:-did not register its extension}"
done

echo "${#failed[@]} of ${#modules[@]} modules failed to load"
exit 1
