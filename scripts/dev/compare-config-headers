#!/usr/bin/env python3
"""Compare two generated config headers, symbol by symbol.

While autoconf and meson both generate a php_config.h, this is the migration's
progress meter: every symbol the meson header does not define yet (or defines
with a different value) is work still to do.  When it reports no differences the
autoconf header and everything that produces it can go.

usage: compare-config-headers <autoconf header> <meson header>
"""

import re
import sys
from collections import Counter

# Values that legitimately differ between two configure runs on different
# machines or at different times.
VOLATILE = {'PHP_UNAME', 'PHP_BUILD_SYSTEM', 'PHP_BUILD_DATE'}

DEFINE = re.compile(r'^#define\s+([A-Za-z_][A-Za-z0-9_]*)[ \t]*(.*)$')
UNDEF = re.compile(r'^/\*\s*#undef\s+([A-Za-z_][A-Za-z0-9_]*)\s*\*/')


def parse(path):
    defined, undefined = {}, set()
    with open(path, errors='ignore') as handle:
        for line in handle:
            if match := DEFINE.match(line):
                defined[match.group(1)] = match.group(2).strip()
            elif match := UNDEF.match(line):
                undefined.add(match.group(1))
    return defined, undefined


def category(name):
    for prefix, label in (
        ('COMPILE_DL_', 'COMPILE_DL_* per-extension shared'),
        ('HAVE_DECL_', 'HAVE_DECL_* declarations'),
        ('SIZEOF_', 'SIZEOF_*'),
        ('ZEND_', 'ZEND_* build variant'),
        ('PHP_', 'PHP_* build info'),
        ('HAVE_LIB', 'HAVE_LIB* libraries'),
        ('HAVE_GD_', 'HAVE_GD_* gd library'),
        ('HAVE_', 'HAVE_* platform/extension'),
    ):
        if name.startswith(prefix):
            return label
    return 'other'


def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__.strip())
    auto_path, meson_path = sys.argv[1], sys.argv[2]
    auto_def, auto_undef = parse(auto_path)
    meson_def, _ = parse(meson_path)

    missing = {n: v for n, v in auto_def.items() if n not in meson_def}
    differing = {n: (v, meson_def[n]) for n, v in auto_def.items()
                 if n in meson_def and meson_def[n] != v and n not in VOLATILE}
    extra = {n: v for n, v in meson_def.items() if n not in auto_def and n not in auto_undef}

    print(f"autoconf: {len(auto_def):4d} defined ({auto_path})")
    print(f"meson:    {len(meson_def):4d} defined ({meson_path})")

    if not missing and not differing and not extra:
        print("\nno differences: the meson header covers the autoconf one")
        return 0

    if missing:
        print(f"\nnot defined by meson yet ({len(missing)}), by category:")
        counts = Counter(category(n) for n in missing)
        for label, count in counts.most_common():
            print(f"  {count:4d}  {label}")
        print("  names: " + ' '.join(sorted(missing)[:40]) +
              (' ...' if len(missing) > 40 else ''))

    if differing:
        print(f"\ndefined with a different value ({len(differing)}):")
        for name, (want, got) in sorted(differing.items())[:40]:
            print(f"  {name}: autoconf={want!r} meson={got!r}")

    if extra:
        print(f"\ndefined by meson but not autoconf ({len(extra)}):")
        print("  " + ' '.join(f"{n}={v}" for n, v in sorted(extra.items())[:20]))

    return 1


if __name__ == '__main__':
    sys.exit(main())
